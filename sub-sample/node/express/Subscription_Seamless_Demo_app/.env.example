# Node.js 22+. Copy this file to .env; never commit credentials.
HOST=127.0.0.1
PORT=3000
APP_MODE=demo
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
CASHFREE_SANDBOX_CLIENT_ID=
CASHFREE_SANDBOX_CLIENT_SECRET=
CASHFREE_PRODUCTION_CLIENT_ID=
CASHFREE_PRODUCTION_CLIENT_SECRET=
# Public HTTPS origin of this Node server, for bank return URLs and webhooks.
PUBLIC_BASE_URL=http://localhost:3000
# Required for public/production use: a unique password of at least 12 characters.
MERCHANT_PASSWORD=
