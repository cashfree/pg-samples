# Choose sandbox or production, then supply matching credentials locally.
# Never commit .env or share your credentials.
CASHFREE_ENV=sandbox
CASHFREE_OAUTH_CLIENT_SECRET=
CASHFREE_OAUTH_CLIENT_ID=
CASHFREE_PARTNER_API_KEY=
# Optional explicit endpoint origins. Blank selects defaults for CASHFREE_ENV.
# Sandbox: https://api-sandbox.cashfree.com and https://sandbox.cashfree.com
# Production: https://api.cashfree.com and https://cashfree.com
CASHFREE_API_BASE_URL=
CASHFREE_PG_BASE_URL=
CASHFREE_PG_API_VERSION=2023-08-01
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_PASSWORD=
PORT=3000
# Origin only. Production requires HTTPS. Register APP_BASE_URL/oauth/callback.
APP_BASE_URL=http://localhost:3000
# Payment return URL, separate from the OAuth callback. Production requires HTTPS.
# Blank defaults to APP_BASE_URL/?order_id={order_id}.
CASHFREE_RETURN_URL=
