# Sandbox only. Supply values locally; never commit .env.
CASHFREE_ENV=sandbox
CASHFREE_OAUTH_CLIENT_SECRET=
CASHFREE_OAUTH_CLIENT_ID=
CASHFREE_PARTNER_API_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_PASSWORD=
PORT=3000
# Origin only, without /oauth/callback. Register APP_BASE_URL/oauth/callback in the dashboard.
APP_BASE_URL=http://localhost:3000
